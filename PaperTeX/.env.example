# Copia este archivo como .env y reemplaza los valores que correspondan a tu
# equipo. .env no se versiona: contiene rutas absolutas locales y el token de
# la instalacion.
#
#   cp PaperTeX/.env.example PaperTeX/.env

# --- Servicio local (companion) -------------------------------------------
# El backend se enlaza solo a loopback. No expongas PaperTeX en la red.
PAPERTEX_HOST=127.0.0.1
PAPERTEX_PORT=8000

# Token por instalacion para las llamadas del frontend al backend.
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAPERTEX_TOKEN=

# --- Base de datos local ---------------------------------------------------
# SQLite en modo WAL. Ruta relativa a PaperTeX/.
PAPERTEX_DB_PATH=db/papertex.sqlite3

# --- MiKTeX (Windows, via interoperabilidad de WSL) ------------------------
# Verificado en este equipo con MiKTeX 26.5. Los ejecutables .exe se invocan
# directamente desde WSL; no hace falta un agente nativo de Windows.
MIKTEX_BIN_PATH=/mnt/c/Users/marco/AppData/Local/Programs/MiKTeX/miktex/bin/x64

# Politica de instalacion de paquetes faltantes: ask | automatic | never
# 'automatic' delega en el instalador propio de MiKTeX.
MIKTEX_INSTALL_POLICY=ask

# --- TeX Live en WSL (proveedor futuro) ------------------------------------
# Dejalo vacio mientras no exista una instalacion de TeX Live en WSL.
TEXLIVE_BIN_PATH=

# --- LSP -------------------------------------------------------------------
TEXLAB_PORT=7658

# --- Frontend --------------------------------------------------------------
# El puerto 5173 pertenece al servidor de desarrollo de TeXlyre upstream.
# PaperTeX usa 5174 para poder ejecutar ambos al mismo tiempo.
VITE_API_BASE_URL=http://127.0.0.1:8000
